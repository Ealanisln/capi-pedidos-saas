# Base de datos PostgreSQL. Usa Neon, Supabase, Railway, Docker o tu proveedor preferido.
DATABASE_URL="postgresql://usuario:password@host:5432/base_de_datos?sslmode=require"
DIRECT_URL="postgresql://usuario:password@host:5432/base_de_datos?sslmode=require"

# URL publica de la aplicacion.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Genera un secreto fuerte para produccion.
# Ejemplo: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-este-secreto"

# Multi-tenant por dominio/subdominio.
ROOT_DOMAIN="localhost"
DEFAULT_TENANT_SLUG="capi"

# Seed local. Cambia estos valores antes de usar una base real.
SEED_ADMIN_EMAIL="superadmin@example.com"
SEED_ADMIN_PASSWORD="CambiaEstaClave123!"
SEED_DEMO_EMAIL_DOMAIN="example.com"
SEED_DEMO_PASSWORD="DemoLocal123!"

# Cron para reiniciar demos. Debe coincidir con el header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="cambia-este-secreto-de-cron"

# Si publicas demos y quieres prefijar correos en login, usa el mismo dominio que SEED_DEMO_EMAIL_DOMAIN.
NEXT_PUBLIC_DEMO_EMAIL_DOMAIN="example.com"
