{
  "name": "capi-print-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Puente local de impresion silenciosa para Capi Pedidos SaaS.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "xyz.nohmendez.capi.printbridge",
    "productName": "Capi Print Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "config.example.json",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
